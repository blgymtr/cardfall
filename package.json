{
  "name": "cardfall",
  "productName": "Cardfall",
  "version": "1.2.0",
  "description": "Steam trading card idler with QR sign-in, an encrypted vault, statistics and a 6-language interface",
  "author": "Ömer",
  "main": "src/main/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "demo": "node scripts/run-demo.js",
    "test": "node --test \"test/*.test.js\"",
    "icon": "node scripts/make-icon.js",
    "dist": "electron-builder --win nsis"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "qrcode": "^1.5.4",
    "steam-session": "^1.9.4",
    "steam-user": "^5.3.0"
  },
  "devDependencies": {
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "playwright-core": "^1.65.0"
  },
  "allowScripts": {
    "electron@45.2.1": true
  },
  "build": {
    "appId": "com.omer.cardfall",
    "productName": "Cardfall",
    "copyright": "© 2026 Ömer",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "src/**",
      "build/icon.png",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "Cardfall-Setup-${version}.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Cardfall",
      "installerLanguages": [
        "en_US",
        "de_DE",
        "tr_TR"
      ],
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "multiLanguageInstaller": true
    },
    "electronLanguages": [
      "tr",
      "de",
      "en-US"
    ],
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "grantFileProtocolExtraPrivileges": false
    }
  },
  "license": "MIT",
  "homepage": "https://github.com/blgymtr/cardfall",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/blgymtr/cardfall.git"
  },
  "bugs": {
    "url": "https://github.com/blgymtr/cardfall/issues"
  },
  "keywords": [
    "steam",
    "trading-cards",
    "idle",
    "electron"
  ],
  "overrides": {
    "adm-zip": "0.6.1",
    "protobufjs": "^7.6.6"
  }
}
